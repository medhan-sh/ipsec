#!/usr/bin/env bash
# ipsec-analyze — thin wrapper so Docker stays an implementation detail
# (Phase 6c). Everything after the script name is passed straight through
# to the `ipsec-analyze` console script running inside the container;
# this file only handles what has to happen on the host side first:
# building the image on a fresh clone, mounting the working directory,
# catching a capture path the container could never see, and getting
# file ownership and the exit code right.
# -u (nounset) deliberately omitted: macOS ships bash 3.2 (GPLv3
# licensing, never upgraded), which treats an empty array's "${arr[@]}"
# expansion as an unbound-variable error under `set -u` — exactly the
# pattern this script uses for its optional docker flags below. Every
# variable here is assigned before use regardless.
set -e

IMAGE="ipsec-analyzer:dev"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 0. Check for Docker. If docker is not available or daemon is inaccessible,
# seamlessly fallback to the local Python CLI if available.
if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
    if [ -f "$SCRIPT_DIR/.venv/bin/python" ]; then
        PYTHON="$SCRIPT_DIR/.venv/bin/python"
    elif command -v python3 >/dev/null 2>&1; then
        PYTHON="python3"
    else
        echo "ipsec-analyze: neither docker nor python3 was found." >&2
        exit 1
    fi
    export PYTHONPATH="$SCRIPT_DIR/src:${PYTHONPATH}"
    exec "$PYTHON" -m ipsec_analyzer.cli "$@"
fi

# 1. Auto-build. A fresh clone has no image yet; build it once, here,
# rather than making that a separate step the user has to know to run
# first. `docker image inspect` is silent and cheap when the image
# already exists, so this costs nothing on every subsequent invocation.
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "ipsec-analyze: building image (first run only)..." >&2
    docker build -t "$IMAGE" "$SCRIPT_DIR"
fi


# 2. Find the capture argument and any -o/--output/--json values among
# "$@", the same way the CLI's own argparse would. Only used for the
# host-side path checks below — the container gets the original "$@"
# untouched.
capture=""
output_path=""
json_path=""
next_slot=""
for arg in "$@"; do
    if [ -n "$next_slot" ]; then
        case "$next_slot" in
            output) output_path="$arg" ;;
            json) json_path="$arg" ;;
        esac
        next_slot=""
        continue
    fi
    case "$arg" in
        -o|--output) next_slot="output" ;;
        --json) next_slot="json" ;;
        -*) ;;
        *) capture="$arg" ;;
    esac
done

# 3. Paths outside the working directory. -v "$PWD":/work means the
# container can only ever see what's under $PWD.
#
# For the capture (an input, must already exist): resolving outside $PWD
# would silently become "file not found" inside the container — a
# confusing way to learn you're in the wrong directory. Only checked when
# the path actually exists on the host; a genuinely missing file is left
# for the tool itself to report.
if [ -n "$capture" ] && [ -e "$capture" ]; then
    capture_dir="$(cd "$(dirname "$capture")" && pwd)"
    abs_capture="$capture_dir/$(basename "$capture")"
    abs_pwd="$(pwd)"
    case "$abs_capture" in
        "$abs_pwd"/*|"$abs_pwd") ;;
        *)
            echo "ipsec-analyze: '$capture' is outside the current directory ($abs_pwd)." >&2
            echo "ipsec-analyze: only \$PWD is visible inside the container — cd to a directory that contains it and try again." >&2
            exit 1
            ;;
    esac
fi

# For an explicit -o/--json (an output, doesn't exist yet): the failure
# mode is worse than a clear error — the container happily "succeeds",
# writes the file into its own filesystem instead of the host's, and
# --rm discards it, so the file just never appears. Checked against the
# path's directory (which must already exist; a missing directory is a
# different, unrelated problem this script doesn't diagnose).
_check_output_dir_under_pwd() {
    out_path="$1"
    out_label="$2"
    [ -n "$out_path" ] || return 0
    out_dir="$(dirname "$out_path")"
    [ -d "$out_dir" ] || return 0
    abs_out_dir="$(cd "$out_dir" && pwd)"
    abs_pwd="$(pwd)"
    case "$abs_out_dir" in
        "$abs_pwd"/*|"$abs_pwd") return 0 ;;
        *)
            echo "ipsec-analyze: $out_label path '$out_path' is outside the current directory ($abs_pwd)." >&2
            echo "ipsec-analyze: the container would write it there silently and --rm would discard it — only \$PWD is shared with the host." >&2
            return 1
            ;;
    esac
}
_check_output_dir_under_pwd "$output_path" "--output"
_check_output_dir_under_pwd "$json_path" "--json"

# 4. File ownership. On Linux, a container process runs as root by
# default, so anything it writes is root-owned on the host — deleting
# your own report then needs sudo. --user maps the container process to
# the calling user instead. On macOS, Docker Desktop's VM already
# reconciles ownership for bind mounts on its own; forcing an
# arbitrary --user there (Docker Desktop has no matching host uid to map
# it to) has caused its own permission problems for other projects, so
# it's skipped there deliberately, not by oversight.
docker_user_args=()
if [ "$(uname -s)" = "Linux" ]; then
    docker_user_args=(--user "$(id -u):$(id -g)")
fi

# 5. TTY and exit codes. -t only when stdout is actually a terminal (not
# when piped or redirected, e.g. in CI) — a `docker run` with -t attached
# to a non-terminal stdout behaves oddly in some environments. No `-e`/
# `set +e` around the final command: its exit status is this script's
# exit status, unchanged, by ordinary shell semantics.
tty_args=()
if [ -t 1 ]; then
    tty_args=(-t)
fi

exec docker run --rm "${tty_args[@]}" "${docker_user_args[@]}" -v "$PWD":/work -w /work -e PYTHONPATH=/work/src "$IMAGE" "$@"
