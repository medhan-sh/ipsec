/* IPsec Analyzer Security Console Stylesheet */

Screen {
    background: #0B0F14;
    color: #E6EDF3;
}

Header {
    background: #111923;
    color: #29D3FF;
    dock: top;
    text-style: bold;
    height: 1;
}

Footer {
    background: #111923;
    color: #8B9BB0;
    dock: bottom;
    height: 1;
}

/* Main Split View Layout */
#main-layout {
    width: 100%;
    height: 100%;
}

#sidebar {
    width: 38;
    min-width: 32;
    max-width: 44;
    height: 100%;
    background: #111923;
    border-right: solid #273447;
    padding: 0 1;
}

#content-container {
    width: 1fr;
    height: 100%;
    background: #0B0F14;
    padding: 0 1;
}

/* Sidebar Elements */
.sidebar-title {
    color: #29D3FF;
    text-style: bold;
    padding: 1 0 0 0;
    border-bottom: solid #273447;
}

#capture-tree {
    height: 1fr;
    background: #111923;
    color: #E6EDF3;
    border: none;
    margin: 1 0;
}

#capture-tree:focus {
    border: none;
}

#capture-preview {
    background: #151F2B;
    border: solid #273447;
    padding: 1;
    margin-bottom: 1;
    min-height: 7;
}

#sidebar-buttons {
    height: auto;
    margin-bottom: 1;
}

#sidebar-buttons Button {
    margin-right: 1;
}

/* Action Buttons */
Button {
    background: #151F2B;
    color: #E6EDF3;
    border: solid #273447;
    min-width: 12;
}

Button:hover {
    background: #1D2D42;
    border: solid #29D3FF;
    color: #29D3FF;
}

Button.-primary {
    background: #142842;
    border: solid #29D3FF;
    color: #29D3FF;
    text-style: bold;
}

Button.-primary:hover {
    background: #1E3D66;
}

Button.-disabled {
    opacity: 50%;
    background: #111923;
    border: solid #273447;
    color: #8B9BB0;
}

/* Status Bar */
#status-bar {
    height: 3;
    background: #111923;
    border-bottom: solid #273447;
    padding: 0 1;
    align: left middle;
}

#status-indicator {
    width: auto;
    height: 1;
    margin-right: 2;
}

#status-label {
    color: #8B9BB0;
}

/* Tabs */
TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 1 0;
    height: 1fr;
}

Tabs {
    background: #111923;
    border-bottom: solid #273447;
}

Tab {
    background: #111923;
    color: #8B9BB0;
    padding: 0 2;
}

Tab.-active {
    background: #151F2B;
    color: #29D3FF;
    text-style: bold;
    border-bottom: solid #29D3FF;
}

/* Cards & Generic Panels */
.card {
    background: #151F2B;
    border: solid #273447;
    padding: 1;
    margin-bottom: 1;
}

.card-title {
    color: #29D3FF;
    text-style: bold;
    margin-bottom: 1;
}

/* Truncation Warning Banner */
.truncation-banner {
    background: #401F09;
    color: #F3B64B;
    border: solid #F3B64B;
    text-style: bold;
    padding: 1;
    margin-bottom: 1;
}

/* Metric Counter Blocks */
.metrics-row {
    height: auto;
    margin-bottom: 1;
}

.metric-box {
    width: 1fr;
    background: #151F2B;
    border: solid #273447;
    padding: 1;
    margin-right: 1;
    align: center middle;
}

.metric-box:last-of-type {
    margin-right: 0;
}

.metric-value {
    text-style: bold;
    color: #E6EDF3;
}

.metric-label {
    color: #8B9BB0;
}

.metric-found {
    color: #FF5C6C;
}

.metric-passed {
    color: #45E38A;
}

.metric-gap {
    color: #F3B64B;
}

/* DataTables */
DataTable {
    background: #111923;
    border: solid #273447;
    height: 1fr;
    color: #E6EDF3;
}

DataTable > .datatable--header {
    background: #151F2B;
    color: #8B9BB0;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1D2D42;
    color: #E6EDF3;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #151F2B;
}

/* Split Pane for Table + Detail View */
.table-detail-split {
    height: 100%;
}

.table-half {
    height: 60%;
}

.detail-half {
    height: 40%;
    margin-top: 1;
    background: #151F2B;
    border: solid #273447;
    padding: 1;
    overflow-y: scroll;
}

/* Badges */
.badge-observed {
    background: #132F21;
    color: #45E38A;
    text-style: bold;
}

.badge-side-channel {
    background: #332612;
    color: #F3B64B;
    text-style: bold;
}

.badge-not-observable {
    background: #1C232E;
    color: #8B9BB0;
}

.badge-ml {
    background: #3A171D;
    color: #FF7B72;
}

.badge-default {
    background: #2E2413;
    color: #E3B341;
}

.badge-high {
    background: #3A171D;
    color: #FF5C6C;
    text-style: bold;
}

.badge-medium {
    background: #332612;
    color: #F3B64B;
    text-style: bold;
}

.badge-low {
    background: #142842;
    color: #6AA8FF;
}

.badge-info {
    background: #1C232E;
    color: #8B9BB0;
}

/* Verdict Styles */
.verdict-box {
    background: #151F2B;
    border-left: wide #45E38A;
    padding: 1;
    margin-bottom: 1;
}

.verdict-box.-ambiguous {
    border-left: wide #F3B64B;
}

.verdict-box.-failed {
    border-left: wide #FF5C6C;
}

/* Modals */
ModalScreen {
    align: center middle;
    background: rgba(11, 15, 20, 0.85);
}

.modal-dialog {
    width: 85%;
    max-width: 105;
    height: 85%;
    max-height: 42;
    background: #151F2B;
    border: solid #29D3FF;
    padding: 1 2;
}

.modal-title {
    color: #29D3FF;
    text-style: bold;
    margin-bottom: 1;
    border-bottom: solid #273447;
    padding-bottom: 1;
}

#modal-meta-label {
    margin-bottom: 1;
    color: #E6EDF3;
}

#modal-hints-box {
    background: #101721;
    border-left: wide #F3B64B;
    padding: 1;
    margin-bottom: 1;
    height: auto;
    color: #E6EDF3;
}

.modal-body {
    height: 1fr;
    margin-bottom: 1;
}

.modal-buttons {
    height: auto;
    align: right middle;
}

/* Filter / Search Inputs */
Input {
    background: #111923;
    border: solid #273447;
    color: #E6EDF3;
    height: 3;
    padding: 0 1;
    margin-bottom: 1;
}

Input:focus {
    border: solid #29D3FF;
}

Input.-empty {
    color: #8B9BB0;
}

