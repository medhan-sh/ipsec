#!/usr/bin/env bash
# ipsec-tui — launcher for the Textual-based IPsec Analyzer TUI.
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# If .venv exists in repo root, use its python, otherwise system python3
if [ -f "$SCRIPT_DIR/.venv/bin/python" ]; then
    PYTHON="$SCRIPT_DIR/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON="python3"
else
    echo "ipsec-tui: python3 not found." >&2
    exit 1
fi

export PYTHONPATH="$SCRIPT_DIR/src:${PYTHONPATH}"
exec "$PYTHON" -m ipsec_analyzer.tui.app "$@"
