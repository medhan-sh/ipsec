# Dockerfile.web — Multi-stage build for the Umbra Web UI.
#
# Stage 1: Build the React frontend with Node.js
# Stage 2: Copy built assets into the Python analyzer image
#
# The web service serves the built React SPA via a stdlib HTTP server
# alongside the analysis API. It does NOT need a terminal or Textual.

# ── Stage 1: Build frontend ──────────────────────────────────────────
FROM node:20-slim AS frontend-build

WORKDIR /build/web-ui

# Install dependencies first (layer cache)
COPY web-ui/package.json web-ui/package-lock.json ./
RUN npm ci --ignore-scripts

# Copy source and build
COPY web-ui/ ./
RUN npm run build


# ── Stage 2: Python backend + built frontend assets ─────────────────
FROM python:3.11-slim

LABEL org.opencontainers.image.title="Umbra Web UI" \
      org.opencontainers.image.description="Passive IPsec forensic console and offline web evidence viewer" \
      org.opencontainers.image.version="1.0.0"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONPATH=/work/src \
    UMBRA_STATIC_DIR=/opt/umbra-web/dist \
    UMBRA_WEB_HOST=0.0.0.0 \
    UMBRA_WEB_PORT=8765

# tshark for analysis (same as main Dockerfile)
ARG TSHARK_VERSION=4.4.18-0+deb13u1
RUN apt-get update \
    && (DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tshark=${TSHARK_VERSION} \
        || DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tshark) \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Python dependencies (layer cache on pyproject.toml)
COPY pyproject.toml ./
RUN pip install --no-cache-dir scapy pyyaml jinja2 pytest textual

# Install the package
COPY src ./src
RUN pip install --no-cache-dir --no-deps .

# Copy the built frontend from stage 1
COPY --from=frontend-build /build/web-ui/dist /opt/umbra-web/dist

# Entrypoint
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh \
    && chmod +x /usr/local/bin/docker-entrypoint.sh

WORKDIR /work
RUN chmod 777 /work /tmp

# Default: serve the web UI on port 8765
EXPOSE 8765

# Container healthcheck: verify local status API responds cleanly
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/api/status', timeout=2)" || exit 1

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["umbra-web", "--host", "0.0.0.0", "--port", "8765"]
